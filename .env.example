# DepthWizard Monorepo Environment Configuration

# Backend Gateway (Node.js/Express)
PORT=5000
NODE_ENV=development
AI_SERVICE_URL=http://localhost:8000
MONGODB_URI=mongodb://localhost:27017/depthwizard
MAX_UPLOAD_SIZE_MB=50
# Comma-separated frontend origins required in production; never use * with credentials.
ALLOWED_ORIGINS=http://localhost:5173
# Durable mount path for uploads and local metadata in production.
PERSISTENT_STORAGE_DIR=./server

# AI Microservice (FastAPI / TensorFlow)
AI_PORT=8000
ENVIRONMENT=development
OUTPUTS_DIR=./ai-service/outputs
TF_ENABLE_ONEDNN_OPTS=0
TF_CPP_MIN_LOG_LEVEL=2

# Frontend (Vite)
VITE_API_URL=http://localhost:5000/api
VITE_AI_URL=http://localhost:8000
